# Copy to .env (git-ignored). Never commit real values. Production uses AWS SSM Parameter Store.
ANTHROPIC_API_KEY=
FRED_API_KEY=
PREDEXON_API_KEY=
# Kalshi keys are needed only for Phase 5 (authenticated WebSocket and orders).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Optional: path to a CA bundle when a corporate or cloud proxy re-terminates TLS.
# TLS verification is never disabled; this only points at a trusted bundle.
REF_MM_CA_BUNDLE=
